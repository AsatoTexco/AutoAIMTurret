# Endereço HTTP da mini torreta ESP32-CAM na rede local
TURRET_URL=http://192.168.100.5
STREAM_URL=http://192.168.100.5:81/stream

# Transporte de vídeo: auto (UDP:82 baixa latência com fallback HTTP:81) | udp | http
AUTOAIM_STREAM_TRANSPORT=auto
AUTOAIM_UDP_PORT=82

# Backend de inferência: auto | vulkan | ort | cpu
AUTOAIM_BACKEND=auto

# Threads caso caia em fallback de CPU
AUTOAIM_CPU_THREADS=4

# Limite máximo de FPS do loop de processamento (ESP32 envia até 30 FPS)
AUTOAIM_MAX_FPS=30

# Webhook do Discord para log de rostos/pessoas (opcional)
DISCORD_WEBHOOK_URL=
DISCORD_COOLDOWN_S=30
DISCORD_ABSENCE_RESET_S=15
