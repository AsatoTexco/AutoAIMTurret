# Endereço HTTP da mini torreta ESP32-CAM na rede local
TURRET_URL=http://192.168.100.5
STREAM_URL=http://192.168.100.5:81/stream

# Backend de inferência: auto | opencl | ort | cpu
AUTOAIM_BACKEND=auto

# Ative 1 apenas se a GPU suportar FP16 via OpenCL sem artefatos
AUTOAIM_OPENCL_FP16=0

# Threads caso caia em fallback de CPU
AUTOAIM_CPU_THREADS=4

# Limite máximo de FPS do loop de processamento
AUTOAIM_MAX_FPS=20
